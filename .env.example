# ==============================================================================
# AI-Powered Campus Helpdesk Assistant Environment Configuration
# ==============================================================================
# Project: Milestone 2 | Course: SCSE4041 - Prompt Engineering
# Team: Invictus (PE-B01-15)
# ==============================================================================

# Gemini API Key (Optional)
# Get a free key at: https://aistudio.google.com/
# Leave empty to run the app in Fallback Mode (Lexical Retrieval via TF-IDF).
GEMINI_API_KEY=

# Gemini Model selection
# Default: gemini-2.5-flash (Fast, accurate, cost-effective multimodal model)
# Alternate: gemini-1.5-flash or gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Maximum PDF upload file size in Megabytes (default: 15)
MAX_UPLOAD_SIZE_MB=15

# Text chunking configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Information retrieval parameters
TOP_K=4
SIMILARITY_THRESHOLD=0.15

# Default retrieval mode: 'lexical' (TF-IDF) or 'semantic' (Gemini embeddings when key is configured)
DEFAULT_RETRIEVAL_METHOD=lexical
