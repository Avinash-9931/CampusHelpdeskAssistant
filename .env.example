# ==============================================================================
# AI-Powered Campus Helpdesk Assistant Environment Configuration
# ==============================================================================
# Project: Milestone 2 | Course: SCSE4041 - Prompt Engineering
# Team: Invictus (PE-B01-15)
# ==============================================================================

# Gemini API Key (Optional)
# Get a free key at: https://aistudio.google.com/
# Leave empty to run the app in Fallback Mode (Lexical Retrieval via TF-IDF).
GEMINI_API_KEY=

# Gemini Model selection
# Default: gemini-2.5-flash (Fast, accurate, cost-effective multimodal model)
GEMINI_MODEL=gemini-2.5-flash

# Gemini Embedding Model selection (used for semantic retrieval)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Maximum PDF upload file size in Megabytes (default: 15)
MAX_UPLOAD_MB=15

# Text chunking configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Information retrieval parameters
TOP_K=4
MIN_RELEVANCE_SCORE=0.13

# Question limits & conversation turns
MAX_QUESTION_CHARS=1000
HISTORY_TURNS=5

# Default retrieval mode: 'lexical' (TF-IDF) or 'semantic' (Gemini embeddings when key is configured)
DEFAULT_RETRIEVAL_METHOD=lexical

# ==============================================================================
# Email & OTP Authentication (Gmail App Password)
# ==============================================================================
# Set to 'false' in production to enforce real SMTP delivery
DEV_MODE=true

# Gmail SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-institutional-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-gmail-app-password
MAIL_FROM_NAME=Campus Helpdesk Security

# Cryptographic secret for HMAC-SHA256 and token signing (32+ chars)
AUTH_SECRET_KEY=change-this-to-a-random-32-byte-hex-string-for-production

# OTP and Session TTL configurations
OTP_TTL_SECONDS=300
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30
